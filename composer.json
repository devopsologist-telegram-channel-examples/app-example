{
    "name": "app/example",
    "description": "Example symfony application",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "baldinof/roadrunner-bundle": "^3.2.3",
        "cuyz/valinor": "^1.16.1",
        "doctrine/dbal": "^4.2.3",
        "doctrine/doctrine-migrations-bundle": "^3.4.2",
        "doctrine/migrations": "^3.9.0",
        "doctrine/orm": "^3.3.3",
        "spiral/roadrunner-metrics": "^3.3",
        "symfony/console": "^7.2.7",
        "symfony/dependency-injection": "^7.2.7",
        "symfony/dotenv": "^7.2.0",
        "symfony/flex": "^2.7.1",
        "symfony/framework-bundle": "^7.2.7",
        "symfony/http-foundation": "^7.2.7",
        "symfony/http-kernel": "^7.2.7",
        "symfony/messenger": "^7.2.7",
        "symfony/monolog-bundle": "^3.10",
        "symfony/routing": "^7.2.3",
        "symfony/runtime": "^7.2.7",
        "symfony/twig-bundle": "^7.2.0",
        "symfony/validator": "^7.2.7",
        "symfony/yaml": "^7.2.6",
        "thesis/postgres": "dev-master",
        "thesis/thesis": "dev-master",
        "twig/twig": "^3.21.1"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.47",
        "friendsofphp/php-cs-fixer": "^3.75.0",
        "icanhazstring/composer-unused": "^0.8.11",
        "maglnet/composer-require-checker": "^4.15",
        "phpyh/coding-standard": "^2.6.3",
        "psalm/plugin-symfony": "^5.2.6",
        "rector/rector": "^1.2.10",
        "vimeo/psalm": "^5.26.1"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Etherlord/postgres-thesis"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Etherlord/thesis"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.2.*"
        }
    }
}
